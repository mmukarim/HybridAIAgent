# Copy this file to .env and fill in your key. Never commit .env.
GEMINI_API_KEY=
# Optional: override the model (check Google AI Studio for current names)
GEMINI_MODEL=
# Optional: override the model (check Ollama for current names)
OLLAMA_MODEL=

OLLAMA_HOST=http://localhost:11434

DATABASE_URL=postgresql://<dbuser>:<dbpassword>@localhost:5432/<dbname>

FILE_STORAGE_PATH=storage/uploads
MAX_UPLOAD_SIZE_MB=50
